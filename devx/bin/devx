#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/presets.sh"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/preflight.sh"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/state.sh"

usage() {
  cat <<'EOF'
Usage: devx <subcommand> [args]
Subcommands:
  help
  doctor [--preset <name>]
  up --preset <name>
  query --prompt "<text>" [--preset <name>]
  switch --preset <name>
  experiment run -f <manifest.yaml>
  experiment report <run-id>
EOF
}

resolve_launch_container_script() {
  if [[ -n "${DEVX_LAUNCH_CONTAINER_SH:-}" ]]; then
    printf '%s\n' "${DEVX_LAUNCH_CONTAINER_SH}"
    return 0
  fi

  local launch_container_dir
  launch_container_dir="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
  printf '%s\n' "${launch_container_dir}/launch_container.sh"
}

run_launch_container() {
  local launch_script

  launch_script="$(resolve_launch_container_script)"
  bash "${launch_script}" "$@"
}

now_unix() {
  date -u +%s
}

doctor() {
  local preset_name="qwen3-0.6b"

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --preset)
        if [[ $# -lt 2 ]]; then
          echo "doctor: missing value for --preset" >&2
          return 1
        fi
        preset_name="${2}"
        shift 2
        ;;
      *)
        echo "doctor: unknown argument: ${1}" >&2
        return 1
        ;;
    esac
  done

  require_preset "${preset_name}"
  local model_id
  model_id="$(preset_model_id "${preset_name}")"
  run_preflight "${model_id}"
}

up() {
  local preset_name=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --preset)
        if [[ $# -lt 2 ]]; then
          echo "up: missing value for --preset" >&2
          return 1
        fi
        preset_name="${2}"
        shift 2
        ;;
      *)
        echo "up: unknown argument: ${1}" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "${preset_name}" ]]; then
    echo "up: missing required --preset" >&2
    return 1
  fi

  require_preset "${preset_name}"
  local model_id
  local hf_token

  model_id="$(preset_model_id "${preset_name}")"
  run_preflight "${model_id}"
  hf_token="$(read_huggingface_token)"

  if ! HF_TOKEN="${hf_token}" VLLM_MODEL="${model_id}" DYNAMO_MODEL="${model_id}" \
    run_launch_container up-rebuild; then
    return 1
  fi

  if ! HF_TOKEN="${hf_token}" VLLM_MODEL="${model_id}" DYNAMO_MODEL="${model_id}" \
    run_launch_container verify-e2e; then
    return 1
  fi

  write_session_state "${preset_name}" "$(now_unix)"
  printf 'DEVX UP PASS: preset=%s model=%s\n' "${preset_name}" "${model_id}"
}

resolve_query_preset() {
  local session_preset=""
  if session_preset="$(read_session_active_preset 2>/dev/null)"; then
    if [[ -n "${session_preset}" ]]; then
      printf '%s\n' "${session_preset}"
      return 0
    fi
  fi

  printf '%s\n' "qwen3-0.6b"
}

build_chat_completion_request_json() {
  local model_id="$1"
  local prompt_file="$2"

  jq -cn \
    --arg model "${model_id}" \
    --rawfile prompt "${prompt_file}" \
    '{model: $model, messages: [{role: "user", content: $prompt}]}'
}

format_query_response_json() {
  local requested_model_id="$1"
  local latency_ms="$2"
  local response_file="$3"
  local response_model
  local reply_excerpt

  response_model="$(jq -r --arg requested_model "${requested_model_id}" '.model // $requested_model' "${response_file}")" || return 1
  reply_excerpt="$(jq -r '(.choices[0].message.content // .choices[0].text // .reply // empty) | tostring | .[0:160]' "${response_file}")" || return 1

  if [[ -z "${reply_excerpt}" ]]; then
    echo "query: launcher response did not include a reply" >&2
    return 1
  fi

  jq -cn \
    --arg model "${response_model}" \
    --argjson latency_ms "${latency_ms}" \
    --arg reply "${reply_excerpt}" \
    '{model: $model, latency_ms: $latency_ms, reply: $reply}'
}

query() (
  local preset_name=""
  local prompt=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --preset)
        if [[ $# -lt 2 ]]; then
          echo "query: missing value for --preset" >&2
          return 1
        fi
        preset_name="${2}"
        shift 2
        ;;
      --prompt)
        if [[ $# -lt 2 ]]; then
          echo "query: missing value for --prompt" >&2
          return 1
        fi
        prompt="${2}"
        shift 2
        ;;
      *)
        echo "query: unknown argument: ${1}" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "${prompt}" ]]; then
    echo "query: missing required --prompt" >&2
    return 1
  fi

  if [[ -z "${preset_name}" ]]; then
    preset_name="$(resolve_query_preset)"
  fi

  require_preset "${preset_name}"
  require_command jq

  local model_id
  local prompt_file
  local request_file
  local response_file
  local normalized_json
  local latency_ms
  local start_ns
  local end_ns
  local temp_dir

  model_id="$(preset_model_id "${preset_name}")"
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "${temp_dir}"' EXIT
  prompt_file="${temp_dir}/prompt.txt"
  request_file="${temp_dir}/request.json"
  response_file="${temp_dir}/response.json"

  printf '%s' "${prompt}" >"${prompt_file}"
  build_chat_completion_request_json "${model_id}" "${prompt_file}" >"${request_file}"
  start_ns="$(date +%s%N)"
  if ! VLLM_MODEL="${model_id}" DYNAMO_MODEL="${model_id}" \
    run_launch_container exec -T dynamo-frontend \
    bash -lc 'curl --silent --show-error --fail -H "Content-Type: application/json" --data-binary @- http://127.0.0.1:8000/v1/chat/completions' \
    <"${request_file}" >"${response_file}"; then
    return 1
  fi
  end_ns="$(date +%s%N)"
  latency_ms=$(( (end_ns - start_ns) / 1000000 ))

  if ! normalized_json="$(format_query_response_json "${model_id}" "${latency_ms}" "${response_file}")"; then
    return 1
  fi
  printf '%s\n' "${normalized_json}"
)

if [[ "${DEVX_DUMP_LAUNCH_CONTAINER_SH:-0}" == "1" ]]; then
  resolve_launch_container_script
  exit 0
fi

cmd="${1:-help}"
shift || true

case "${cmd}" in
  help)
    usage
    ;;
  doctor)
    doctor "$@"
    ;;
  up)
    up "$@"
    ;;
  query)
    query "$@"
    ;;
  switch|experiment)
    echo "not yet implemented: ${cmd}" >&2
    exit 2
    ;;
  *)
    echo "unknown subcommand: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
